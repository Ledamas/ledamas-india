# ==============================================================================
# LE DAMAS Next.js Frontend - Environment Variables
# Copy to .env.local on the server before running `npm run build`
# ==============================================================================

# API Base URL:
# - Behind Nginx (standard production): Leave EMPTY (or set to your public domain https://ledamas.in)
# - Direct EC2 access: Set to http://YOUR_EC2_PUBLIC_IP:5000 or leave empty to use Next.js rewrites proxy
NEXT_PUBLIC_API_URL=

# Internal Backend URL used by Next.js during Server-Side Rendering (SSR)
INTERNAL_API_URL=http://127.0.0.1:5000

# Optional 3rd party integrations
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
