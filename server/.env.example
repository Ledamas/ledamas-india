# ==============================================================================
# LE DAMAS Express API Backend - Environment Variables
# Copy to .env on the server
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Database Connection (Neon PostgreSQL / AWS RDS / Supabase)
DATABASE_URL="postgresql://user:password@ep-sample-neon.region.aws.neon.tech/ledamas_db?sslmode=require"

# JWT Authentication
JWT_SECRET="replace_with_a_long_random_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# Admin Access Credentials (Required for /api/v1/admin/login)
ADMIN_ID="admin"
ADMIN_PASSWORD="replace_with_secure_admin_password"

# Razorpay Payment Gateway (Live credentials on production)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_live_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# CORS Allowed Origins (Comma-separated list; or * to allow all during initial setup)
# Include your domain and EC2 IP address if accessing directly
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,https://ledamas.in,https://www.ledamas.in"

# Message Central Phone OTP Auth Credentials
MESSAGE_CENTRAL_CUSTOMER_ID="YOUR_CUSTOMER_ID"
MESSAGE_CENTRAL_AUTH_TOKEN="YOUR_AUTH_TOKEN"

# Email Notifications (Resend / SMTP)
RESEND_API_KEY=""
EMAIL_FROM="orders@ledamas.in"

# Health Check Basic Auth
HEALTH_USERNAME="admin"
HEALTH_PASSWORD="replace_with_health_secret"
