# ==============================================================================
# LE DAMAS Luxury Chocolaterie - Production Nginx Reverse Proxy Configuration
# Place in: /etc/nginx/sites-available/ledamas
# Enable:   sudo ln -s /etc/nginx/sites-available/ledamas /etc/nginx/sites-enabled/
# Test:     sudo nginx -t && sudo systemctl reload nginx
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MAIN STOREFRONT - HTTP Redirect to HTTPS
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ledamas.in www.ledamas.in;
    return 301 https://$host$request_uri;
}

# ------------------------------------------------------------------------------
# 2. MAIN STOREFRONT - HTTPS Server (ledamas.in & www.ledamas.in)
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ledamas.in www.ledamas.in;

    # SSL Certificates
    ssl_certificate /etc/letsencrypt/live/ledamas.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ledamas.in/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 25M;

    # Next.js Static Cache Optimization
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000/_next/static/;
        proxy_cache_valid 200 365d;
        expires 365d;
        access_log off;
    }

    # Express API Backend & Real-Time Streams (SSE)
    location /api/ {
        proxy_pass http://127.0.0.1:5000; # ⚠️ Crucial: NO trailing slash!
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # SSE Directives
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        chunked_transfer_encoding off;
    }

    # Next.js Storefront Frontend
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# ------------------------------------------------------------------------------
# 3. ADMIN SUBDOMAIN - HTTP Redirect to HTTPS (admin.ledamas.in)
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name admin.ledamas.in;
    return 301 https://$host$request_uri;
}

# ------------------------------------------------------------------------------
# 4. ADMIN SUBDOMAIN - HTTPS Server (admin.ledamas.in)
# ------------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.ledamas.in;

    # SSL Certificates (sudo certbot --nginx -d admin.ledamas.in)
    ssl_certificate /etc/letsencrypt/live/admin.ledamas.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.ledamas.in/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 25M;

    # Next.js Static Cache Optimization for Admin
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000/_next/static/;
        proxy_cache_valid 200 365d;
        expires 365d;
        access_log off;
    }

    # Admin API Gateway (Same-Origin to avoid CORS)
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # SSE Directives for Live Order Feed & Visitor Tracker
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        chunked_transfer_encoding off;
    }

    # Admin UI (Proxies to Next.js; middleware rewrites root / to /admin)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
