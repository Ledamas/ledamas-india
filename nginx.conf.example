# ==============================================================================
# LE DAMAS Luxury Chocolaterie - Production Nginx Reverse Proxy Configuration
# Place in: /etc/nginx/sites-available/ledamas
# Enable:   sudo ln -s /etc/nginx/sites-available/ledamas /etc/nginx/sites-enabled/
# Test:     sudo nginx -t && sudo systemctl reload nginx
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: HTTP ONLY (Use when testing via AWS Public IP before SSL certificate)
# If you don't have SSL yet, uncomment this block and comment out the HTTPS blocks below:
